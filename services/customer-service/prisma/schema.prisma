generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberShip {
  mid       Int        @id @default(autoincrement())
  mname     String     @unique @db.VarChar(50)
  score     Int        @default(10)
  customers Customer[]
}

model Customer {
  uid        Int        @id
  fullname   String     @db.VarChar(100)
  mid        Int
  membership MemberShip @relation(fields: [mid], references: [mid])
}